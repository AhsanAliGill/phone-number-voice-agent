# Copy this file to .env and fill in your own keys.
# NEVER put real keys in this file: it is committed to git. Only .env is ignored.

# ---- LiveKit (https://cloud.livekit.io -> Settings -> Keys) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Leave empty for automatic dispatch into every new room
AGENT_NAME=

# ---- Speech-to-text ----
# deepgram (default): Nova-3 multilingual streaming, with confidence scores
# groq: Whisper large-v3-turbo via the Groq API (uses GROQ_API_KEY below)
STT_PROVIDER=deepgram
GROQ_STT_MODEL=whisper-large-v3-turbo
# empty = auto-detect per utterance (best for Hinglish); or "hi" / "en"
GROQ_STT_LANGUAGE=
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# ---- Text-to-speech ----
# deepgram (default): Aura-2, uses DEEPGRAM_API_KEY above
# groq: Orpheus via the Groq API (accept the model terms in the Groq console first)
# Both voices are English-only, so the agent replies in English.
TTS_PROVIDER=deepgram
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
TTS_CACHE_DIR=.cache/tts

# ---- Audio quality ----
# bvc | bvc_telephony | nc | none   (bvc/nc need LiveKit Cloud; use "none" on a self-hosted server)
NOISE_CANCELLATION=bvc
MIN_SNR_DB=8
MIN_STT_CONFIDENCE=0.55

# ---- Turn taking ----
PAUSE_TIMEOUT_S=4
ENDPOINTING_MIN_DELAY_S=0.6

# ---- Backend ----
DATABASE_URL=sqlite:///./data/phone_numbers.db
API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
